# Database
DATABASE_URL="postgresql://crm_user:crm_password@localhost:5432/crm_assessment?schema=public"

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h

# AI Provider: "openai" | "gemini" | "none"
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
